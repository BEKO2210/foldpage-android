<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share to FoldPage" from the browser or any reader app.
                 launchMode singleTask above means a share into an already
                 running app arrives via onNewIntent, not a second activity. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Exported, and it has to be: a media-button receiver is delivered
             to by the system, not by this app. Without the MEDIA_BUTTON
             filter the session exists but the phone reports "Media button
             session is null" and a headset or a Bluetooth pause key reaches
             nothing — measured on the device, which is how this was found. -->
        <receiver
            android:name=".SpeechControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The lock-screen controls for reading aloud are a notification, and
         since Android 13 that needs permission. Refused, the article still
         reads — it just has no controls outside the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Since Android 11 an app sees only the packages it declares an interest
         in. Without this block the phone reports exactly one speech engine —
         the default — no matter how many are installed, and picking a German
         neural engine for German articles and another one for English would be
         impossible for a reason nothing in the log ever mentions. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
