{
  "name": "foldpage-android",
  "version": "1.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "test": "node --test lib/*.test.ts",
    "corpus": "node scripts/corpus.mjs measure",
    "corpus:fetch": "node scripts/corpus.mjs fetch",
    "reader-render": "npm run build && node scripts/reader-render.mjs",
    "ui:check": "node .claude/skills/foldpage-product-ux/scripts/ui-check.mjs",
    "jargon": "node scripts/jargon-audit.mjs",
    "voice:check": "node scripts/voice-flow-check.mjs",
    "voices:aar": "bash scripts/fetch-sherpa-aar.sh",
    "voices:catalogue": "node scripts/build-voice-catalogue.mjs",
    "sync": "npm run build && npx cap sync android",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run sync && cd android && ./gradlew assembleRelease",
    "assets": "node scripts/make-assets.mjs && node scripts/adaptive-icon.mjs",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@mozilla/readability": "^0.6.0",
    "idb": "^8.0.3",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
